{
  "name": "wynncraft-build-recommender",
  "private": true,
  "version": "0.39.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "update-items": "node scripts/update-items.mjs",
    "update-tree-effects": "node scripts/update-tree-effects.mjs",
    "update-prices": "node scripts/update-prices.mjs",
    "update-guide-trees": "node scripts/update-guide-trees.mjs",
    "update-item-weights": "node scripts/update-item-weights.mjs",
    "update-event-items": "node scripts/update-event-items.mjs",
    "update-tomes-aspects": "node scripts/update-tomes-aspects.mjs",
    "test": "vitest run",
    "test:matrix": "vitest run tests/matrix",
    "test:sp": "vitest run tests/skillpoints.test.js",
    "test:wynnbuilder": "vitest run tests/wynnbuilder-link.test.js",
    "test:stable": "vitest run tests/stability.test.js",
    "test:workers": "vitest run tests/workers.test.js",
    "test:discord": "vitest run tests/discord.test.js",
    "test:optimizer": "vitest run tests/optimizer.test.js",
    "test:feedback": "vitest run tests/feedback.test.js",
    "test:share": "vitest run tests/share.test.js",
    "bench:optimizer": "vite-node scripts/bench-optimizer.mjs --",
    "test:deep": "vitest run --config vitest.deep.config.js",
    "test:soak": "vitest run --config vitest.soak.config.js"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  }
}
